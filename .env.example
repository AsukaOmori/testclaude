# Multi-Provider Data Layer Configuration
# Copy to .env and fill in values as needed.

# ---------------------------------------------------------------------------
# API Keys (optional — providers without keys are skipped automatically)
# ---------------------------------------------------------------------------
# ALPHAVANTAGE_API_KEY=your_key_here
# TIINGO_API_KEY=your_key_here
# JQUANTS_API_KEY=your_refresh_token_here

# ---------------------------------------------------------------------------
# Provider priority (comma-separated provider names)
# Available: yfinance, stooq, alphavantage
# ---------------------------------------------------------------------------
PROVIDER_PRIORITY_US=alphavantage,yfinance
PROVIDER_PRIORITY_JP=stooq,yfinance
PROVIDER_PRIORITY_KR=yfinance

# ---------------------------------------------------------------------------
# Cache settings
# ---------------------------------------------------------------------------
DATA_CACHE_DIR=./data_cache
CACHE_MAX_AGE_HOURS=24
# CACHE_FORCE_REFRESH=1          # Uncomment to bypass cache

# ---------------------------------------------------------------------------
# Data source mode
#   auto          — try cache first, then providers (default)
#   cache_only    — only use cached data; error on miss (for reproducibility)
#   provider_only — always fetch fresh data; ignore cache
# ---------------------------------------------------------------------------
DATA_SOURCE=auto

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------
# VALIDATION_STRICT=1             # Uncomment to raise on validation warnings
